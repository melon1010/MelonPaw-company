# Docker Compose 对外端口。
MELON_CONSOLE_PORT=5173
MELON_API_PORT=8088

# 必须填写宿主机绝对路径。Java 容器和它启动的 Agent 沙箱通过该路径共享工作区。
MELON_HOST_DATA_DIR=/Users/yourname/.melonPaw-CompanyAI-compose

# Java 允许只读导入 MCP 源码的宿主机目录，也必须使用绝对路径。
MELON_HOST_MCP_IMPORT_DIR=/Users/yourname/IdeaWorkSpace/Github

# 页面使用宿主机路径配置 MCP 时，将该前缀映射到 Java 容器内的只读目录。
MELON_MCP_PATH_MAPPINGS={"/Users/yourname/IdeaWorkSpace/Github":"/mcp-imports"}

# 沙箱镜像和隔离参数。
MELON_SANDBOX_IMAGE=melonpaw-company-sandbox:latest
MELON_SANDBOX_NETWORK=bridge
# Docker 已安装 gVisor 时填写 runsc；留空使用默认 runtime。
MELON_SANDBOX_RUNTIME=

# 首次初始化默认不要求令牌。公网部署应设置固定令牌，或开启自动生成。
MELON_BOOTSTRAP_TOKEN=
MELON_GENERATE_BOOTSTRAP_TOKEN=false

# 可选：生产环境建议由密钥管理系统注入 Base64 主密钥；留空会保存到数据目录。
MELON_MASTER_KEY=
TZ=Asia/Shanghai

